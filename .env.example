# --- Meeting API ---
PORT=8787
DB_FILE=./data/meeting.db

# Public URL used to build invite links (optional; defaults to request origin)
# PUBLIC_URL=https://meet.example.com

# --- LiveKit ---
# Local dev (docker compose up -d):
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# For a phone/emulator, advertise your PC's LAN IP instead:
# LIVEKIT_URL=ws://192.168.1.20:7880
# LIVEKIT_NODE_IP=192.168.1.20

# LiveKit Cloud:
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=APIxxxxxxxx
# LIVEKIT_API_SECRET=your-secret

# Optional: HTTP endpoint for the server-side RoomService (defaults to LIVEKIT_URL with http/https)
# LIVEKIT_HTTP_URL=https://your-project.livekit.cloud